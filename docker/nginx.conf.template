# nginx.conf.template – single-container reverse proxy for gridone
#
# Rendered at container start by `envsubst` (see docker CMD), which substitutes
# only ${NGINX_BIND_ADDRESS} and leaves every other `$var` intact for nginx.
#
# Responsibilities:
#   1. Serve the built Vite SPA at / (static files from /app/static)
#   2. Proxy /api/* requests to the FastAPI backend (uvicorn on 127.0.0.1:8000)
#   3. Handle WebSocket upgrade for /api/ws/* paths

worker_processes auto;
pid /run/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile    on;
    tcp_nopush  on;

    access_log /dev/stdout;

    # Enable gzip compression for text-based responses. The GLB building scene
    # is uncompressed float32 geometry (model/gltf-binary) and compresses well,
    # so it is included here rather than shipped raw.
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml model/gltf-binary;
    gzip_min_length 256;

    # WebSocket connection map: set $connection_upgrade to "upgrade" when the
    # client sends an Upgrade header, otherwise keep it as "close".
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen ${NGINX_BIND_ADDRESS}:8765;
        server_name _;

        # --- API: proxy HTTP + WebSocket to uvicorn on port 8000 -----------
        #
        # /api/ is stripped by the rewrite so FastAPI sees the original paths
        # (e.g. /devices, /ws/devices). This keeps the backend code unchanged.
        location /api/ {
            rewrite ^/api(/.*)$ $1 break;

            # IFC model uploads: the API enforces its own 200 MB cap, nginx
            # only needs to stop rejecting large bodies (default is 1 MB).
            client_max_body_size 256m;

            proxy_pass         http://127.0.0.1:8000;
            proxy_http_version 1.1;

            # Headers required for WebSocket upgrade
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection $connection_upgrade;

            # Standard proxy headers
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;

            # Disable buffering for WebSocket / SSE streams
            proxy_buffering off;

            # Long timeout for WebSocket connections (1 hour)
            proxy_read_timeout  3600s;
            proxy_send_timeout  3600s;
        }

        # --- SPA: serve static assets and fallback to index.html -----------
        root /app/static;
        index index.html;

        # Content Security Policy, REPORT-ONLY for now: violations show up in
        # the browser console (no report collector yet) without breaking
        # anything. Promote to `Content-Security-Policy` once a production
        # build has been exercised end to end with no report.
        #
        #   script-src   Gridone's own bundles plus the hash of the inline
        #                theme script in index.html (recompute it whenever
        #                that script changes: sha256 of its exact body).
        #   style-src    Tailwind bundle + Google Fonts stylesheet; inline
        #                styles are set by React through the CSSOM, but some
        #                dependencies still inject <style> elements.
        #   img-src      self, data: and blob: for driver presentation assets
        #                served through the authenticated API and kept as
        #                Blob URLs; https: for legacy driver `image_src`
        #                pictures hosted elsewhere.
        #   connect-src  the API and its WebSocket on the same origin.
        #   object-src   none: no plugin content, ever.
        add_header Content-Security-Policy-Report-Only
            "default-src 'self'; script-src 'self' 'sha256-JQrNawlrvhZViu5KscUcYPzzS31gTZp9A99/Rj/MXvk='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' ws: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; worker-src 'self' blob:"
            always;
        add_header X-Content-Type-Options nosniff always;

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
