  "collector": {
    "$defs": {
      "CollectorPort": {
        "additionalProperties": false,
        "description": "A port authored on a collector: how far along the bar, and which face.\n\nInlets and outlets are not on opposite faces in general. A return\ncollector can take its inlets from the north and let its outlet out west,\nalong the bar.",
        "properties": {
          "offset": {
            "maximum": 10000,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "side": {
            "enum": ["+x", "-x", "+y", "-y", "+z", "-z"],
            "title": "Side",
            "type": "string"
          }
        },
        "required": ["offset", "side"],
        "title": "CollectorPort",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "The collector is the one type whose shape is authored per instance: a\nbar serving three departures is not the same shape as one serving eight.\n\n``axis`` says which way the bar runs, which is why ``rotation`` must be 0 on\na collector: having both would let them disagree.",
    "properties": {
      "axis": {
        "enum": ["x", "y"],
        "title": "Axis",
        "type": "string"
      },
      "length": {
        "maximum": 10000,
        "minimum": 2,
        "title": "Length",
        "type": "integer"
      },
      "ports": {
        "patternProperties": {
          "^(in|out)_[1-9][0-9]*$": {
            "$ref": "#/$defs/CollectorPort"
          }
        },
        "title": "Ports",
        "type": "object"
      }
    },
    "required": ["axis", "length", "ports"],
    "title": "collector",
    "type": "object",
    "x-footprint": null,
    "x-ports": {},
    "x-ports-authored": true,
    "x-passages": "all",
    "x-gates-flow": false,
    "x-slots": [],
    "x-required-slots": [],
    "x-inline": false,
    "x-rotation-locked": true
  },
